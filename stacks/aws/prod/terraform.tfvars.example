region                      = "us-east-1"
instance_name               = "agent-runtime-gw"
instance_type               = "t3.small"
ami_id                      = "ami-xxxxxxxxxxxxxxxxx"
# Set create_dedicated_network = true to let the stack create a VPC and subnet.
create_dedicated_network    = false
# dedicated_vpc_cidr        = "10.10.0.0/16"
# dedicated_subnet_cidr     = "10.10.0.0/24"
subnet_id                   = "subnet-xxxxxxxxxxxxxxxxx"
vpc_security_group_ids      = ["sg-xxxxxxxxxxxxxxxxx"]
# public_ip_mode = "none" | "ephemeral" | "static"
public_ip_mode              = "ephemeral"
deletion_protection         = false
enable_startup_bootstrap    = false
disk_size_gb                = 20

tags = {
  Name      = "agent-runtime-gw"
  component = "agent-runtime"
  env       = "prod"
}
