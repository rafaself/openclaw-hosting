project_id         = "your-gcp-project-id"
region             = "us-central1"
zone               = "us-central1-a"
instance_name      = "agent-runtime-gw"
machine_type       = "e2-small"
disk_size_gb       = 20
network            = "default"
# public_ip_mode = "none" | "ephemeral" | "static"
public_ip_mode     = "ephemeral"
deletion_protection = false
create_ssh_firewall = true
# Empty by default: set your admin CIDR(s) explicitly to open SSH.
ssh_source_cidrs   = []

labels = {
  component = "agent-runtime"
  env       = "prod"
}
